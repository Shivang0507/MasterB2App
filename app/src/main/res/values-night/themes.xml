<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MasterB2App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="backgroundColor">@color/black</item>
        <item name="fontFamily">@font/bree_serif</item>
    </style>

    <style name="Theme.MasterB2App" parent="Base.Theme.MasterB2App" />

    <style name="textviewBlue" parent="Base.Theme.MasterB2App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:textColor">#1F41BB</item>
    </style>

    <style name="textview" parent="Base.Theme.MasterB2App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="edittext" parent="Base.Theme.MasterB2App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_margin">20dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="textviewBottom" parent="Base.Theme.MasterB2App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:textColor">#767676</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="button" parent="Base.Theme.MasterB2App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">20dp</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>